; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Battlsim"
run/main_scene="uid://cnb6kqb10ei67"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/low_processor_mode=true
config/icon="res://icon.svg"

[autoload]

Log="*res://scripts/autoload/Log.gd"
DataRegistry="*res://scripts/autoload/DataRegistry.gd"
GameEvents="*res://scripts/autoload/GameEvents.gd"
LocationManager="*res://scripts/autoload/LocationManager.gd"
AlchemyManager="*res://scripts/autoload/AlchemyManager.gd"
BlacksmithManager="*res://scripts/autoload/BlacksmithManager.gd"
EnchantManager="*res://scripts/autoload/EnchantManager.gd"
Bestiary="*res://scripts/autoload/Bestiary.gd"
RunState="*res://scripts/autoload/RunState.gd"
SceneManager="*res://scripts/autoload/SceneManager.gd"
EnemyFactory="*res://scripts/autoload/EnemyFactory.gd"
SkillManager="*res://scripts/autoload/SkillManager.gd"
ItemManager="*res://scripts/autoload/ItemManager.gd"
CharacterManager="*res://scripts/autoload/CharacterManager.gd"
SaveManager="*res://scripts/autoload/SaveManager.gd"
LevelSystem="*res://scripts/LevelSystem.gd"
RewardsManager="*res://scripts/autoload/RewardsManager.gd"
MomentumSystem="*res://scripts/autoload/MomentumSystem.gd"
ShopManager="*res://scripts/autoload/ShopManager.gd"
DungeonStateManager="*res://scripts/autoload/DungeonStateManager.gd"
RaceElementalData="*res://scripts/autoload/RaceElementalData.gd"
RandomManager="*res://scripts/autoload/RandomManager.gd"
ArenaNetworkManager="*res://scripts/network/ArenaNetworkManager.gd"
StatusEffects="*res://scripts/autoload/StatusEffects.gd"
ClassEquipmentBias="*res://scripts/autoload/ClassEquipmentBias.gd"
GuildManager="*res://scripts/autoload/GuildManager.gd"
DefeatManager="*res://scripts/autoload/DefeatManager.gd"
RankManager="*res://scripts/autoload/RankManager.gd"
WorldClock="*res://scripts/autoload/WorldClock.gd"
AdventurerManager="*res://scripts/autoload/AdventurerManager.gd"
PartyManager="*res://scripts/autoload/PartyManager.gd"
BondManager="*res://scripts/autoload/BondManager.gd"
CommissionManager="*res://scripts/autoload/CommissionManager.gd"
RumorManager="*res://scripts/autoload/RumorManager.gd"
EncounterManager="*res://scripts/autoload/EncounterManager.gd"

[display]

window/size/viewport_width=1200
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://ui/default_theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
